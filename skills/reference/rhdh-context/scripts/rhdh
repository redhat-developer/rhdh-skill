#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.9"
# dependencies = []
# ///
"""Thin wrapper to run rhdh CLI.

This script allows running the CLI directly without python -m:
    uv run scripts/rhdh status
    uv run scripts/rhdh doctor

The rhdh package lives beside this script in the skill directory and is
self-contained: it needs nothing beyond the standard library (ADR-0006).
"""

import sys
from pathlib import Path

# Add the skill directory to the path (where rhdh package lives)
skill_dir = Path(__file__).parent.parent
sys.path.insert(0, str(skill_dir))

from rhdh.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
